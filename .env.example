RUNHARNESS_PORT=8888

# Runtime data defaults to ~/.runharness/projects/<project-hash>.
# RUNHARNESS_HOME=$HOME/.runharness

# Optional local client profile directories.
# RUNHARNESS_CLAUDE_CONFIG_DIR=$HOME/.claude-gw
# RUNHARNESS_CODEX_HOME=$HOME/.codex-gw

# API mode is optional. CLI mode reuses each installed client's login.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
